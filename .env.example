# Copy this file to .env.local and fill in your key. .env.local is gitignored.

# Required. Cekura API key; the dev server adds it to API requests so it never reaches the browser.
CEKURA_API_KEY=

# Optional. ElevenLabs API key, for the 11Labs source toggle and the ElevenLabs tab in call details
# (conversations Cekura never imported). Kept server-side the same way.
# ELEVENLABS_API_KEY=

# Optional. Cekura project to open on first load (defaults to 3201).
# VITE_CEKURA_PROJECT_ID=3201
