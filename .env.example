# Copy this file to .env.local and fill in your key. .env.local is gitignored.

# Required. Cekura API key; the dev server adds it to API requests so it never reaches the browser.
CEKURA_API_KEY=

# Optional. Cekura project to open on first load (defaults to 3201).
# VITE_CEKURA_PROJECT_ID=3201

# Optional. Folder with one <agent family>/environments.json per ElevenLabs agent family, used to
# show branch and agent names instead of raw IDs. Defaults to the ai-receptionist checkout at
# ~/boulevard/ai-receptionist/packages/elevenlabs/agents/_managed.
# ELEVENLABS_MANAGED_AGENTS_DIR=
